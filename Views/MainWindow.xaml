<Window x:Class="NassefStore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="محل ناصف — نظام الإدارة"
        Height="768" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignBackground}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ══ الشريط الجانبي ══ -->
        <Border Grid.Column="1" Background="#1A237E">
            <DockPanel>
                <!-- الشعار -->
                <Border DockPanel.Dock="Top" Background="#0D1457" Padding="16,24">
                    <StackPanel>
                        <TextBlock Text="🔧 ناصف" FontSize="22" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="محل أدوات وسباكة وكهرباء" FontSize="10"
                                   Foreground="#9FA8DA" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- القائمة -->
                <StackPanel DockPanel.Dock="Top" Margin="8,16,8,0">
                    <TextBlock Text="الرئيسية" Foreground="#7986CB" FontSize="10"
                               FontWeight="Bold" Margin="12,0,0,8"/>

                    <Button Style="{StaticResource SidebarButton}" Click="NavDashboard_Click" x:Name="BtnDashboard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="لوحة التحكم" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="NavSales_Click" x:Name="BtnSales">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="فاتورة بيع جديدة" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="ReceiptText" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="NavSalesHistory_Click" x:Name="BtnSalesHistory">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="سجل المبيعات" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="History" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="12,8" Background="#3949AB"/>
                    <TextBlock Text="المخزون" Foreground="#7986CB" FontSize="10"
                               FontWeight="Bold" Margin="12,0,0,8"/>

                    <Button Style="{StaticResource SidebarButton}" Click="NavProducts_Click" x:Name="BtnProducts">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="المنتجات" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="Package" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="NavPurchases_Click" x:Name="BtnPurchases">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="المشتريات" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="TruckDelivery" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="12,8" Background="#3949AB"/>
                    <TextBlock Text="الحسابات" Foreground="#7986CB" FontSize="10"
                               FontWeight="Bold" Margin="12,0,0,8"/>

                    <Button Style="{StaticResource SidebarButton}" Click="NavSuppliers_Click" x:Name="BtnSuppliers">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="الموردين" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="NavCustomers_Click" x:Name="BtnCustomers">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="العملاء" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="NavReturns_Click" x:Name="BtnReturns">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="المرتجعات" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="KeyboardReturn" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="12,8" Background="#3949AB"/>
                    <TextBlock Text="التقارير" Foreground="#7986CB" FontSize="10"
                               FontWeight="Bold" Margin="12,0,0,8"/>

                    <Button Style="{StaticResource SidebarButton}" Click="NavReports_Click" x:Name="BtnReports">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="التقارير" FontSize="13" Margin="0,0,10,0"/>
                            <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- تنبيه النواقص -->
                <Border DockPanel.Dock="Bottom" Background="#C62828" Padding="12,10"
                        Margin="8" CornerRadius="4" Cursor="Hand"
                        x:Name="LowStockAlert" Visibility="Collapsed"
                        MouseLeftButtonDown="LowStockAlert_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18"
                                                 Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Foreground="White" FontSize="12">
                            <Run Text="نواقص: "/>
                            <Run x:Name="LowStockCount" Text="0" FontWeight="Bold"/>
                            <Run Text=" صنف"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ══ منطقة المحتوى ══ -->
        <Grid Grid.Column="0" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0">
                    <TextBlock x:Name="PageTitleBar" DockPanel.Dock="Right"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#212121" VerticalAlignment="Center"
                               Text="لوحة التحكم"/>
                    <TextBlock x:Name="CurrentDateText" FontSize="13"
                               Foreground="#757575" VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                </DockPanel>
            </Border>

            <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
