<Page x:Class="NassefStore.Views.Sales.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5" FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,12" UniformCornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="UnpaidOnly" Content="غير مسددة فقط"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,8,0"/>
                <Button Content="هذا الشهر" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="ThisMonth_Click" Margin="0,0,8,0"/>
                <Button Content="بحث" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Search_Click" Margin="0,0,8,0"/>
                <DatePicker x:Name="DateTo" Style="{StaticResource MaterialDesignDatePicker}"
                            materialDesign:HintAssist.Hint="إلى" Width="145" Margin="0,0,8,0"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="DateFrom" Style="{StaticResource MaterialDesignDatePicker}"
                            materialDesign:HintAssist.Hint="من" Width="145" Margin="0,0,8,0"/>
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </StackPanel>
        </materialDesign:Card>
        <materialDesign:Card Grid.Row="1" Padding="0" UniformCornerRadius="8">
            <DataGrid x:Name="PurchasesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="140"/>
                    <DataGridTextColumn Header="التاريخ" Width="95">
                        <DataGridTextColumn.Binding><Binding Path="PurchaseDate" StringFormat="dd/MM/yyyy"/></DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="المورد" Binding="{Binding Supplier.Name}" Width="*"/>
                    <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethod}" Width="100"/>
                    <DataGridTextColumn Header="الإجمالي" Width="120">
                        <DataGridTextColumn.Binding><Binding Path="TotalAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="المدفوع" Width="110">
                        <DataGridTextColumn.Binding><Binding Path="PaidAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="المتبقي" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Setter Property="Text" Value="مسدد ✓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                    <Setter Property="Text" Value="{Binding RemainingAmount, StringFormat='{}{0:N2} ج'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
        <materialDesign:Card Grid.Row="2" Padding="12,8" Margin="0,8,0,0" UniformCornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="الإجمالي: " Foreground="#757575" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotal" Text="0.00 جنيه" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" FontSize="16"
                           Margin="4,0,24,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                <TextBlock Text="العدد: " Foreground="#757575" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCount" Text="0" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Page>
