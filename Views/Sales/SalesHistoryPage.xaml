<Page x:Class="NassefStore.Views.Sales.SalesHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5" FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط البحث والفلتر -->
        <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,12" UniformCornerRadius="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="CreditOnly" Content="آجل فقط"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              Checked="CreditOnly_Changed" Unchecked="CreditOnly_Changed"
                              Margin="0,0,8,0"/>
                <Button Content="اليوم" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="Today_Click" Margin="0,0,8,0"/>
                <Button Content="بحث" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Search_Click" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="🔍 فاتورة / عميل"
                         Width="160" Height="38" Margin="0,0,8,0"
                         TextChanged="Search_Changed"/>
                <DatePicker x:Name="DateTo"
                            Style="{StaticResource MaterialDesignDatePicker}"
                            materialDesign:HintAssist.Hint="إلى"
                            Width="145" Margin="0,0,4,0"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker x:Name="DateFrom"
                            Style="{StaticResource MaterialDesignDatePicker}"
                            materialDesign:HintAssist.Hint="من"
                            Width="145" Margin="0,0,8,0"/>
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- جدول الفواتير -->
        <materialDesign:Card Grid.Row="1" Padding="0" UniformCornerRadius="8">
            <DataGrid x:Name="SalesGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      SelectionChanged="SalesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة"
                                       Binding="{Binding InvoiceNumber}" Width="125"/>
                    <DataGridTextColumn Header="التاريخ" Width="90">
                        <DataGridTextColumn.Binding>
                            <Binding Path="SaleDate" StringFormat="dd/MM/yyyy"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الوقت" Width="58">
                        <DataGridTextColumn.Binding>
                            <Binding Path="SaleDate" StringFormat="HH:mm"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="العميل"
                                       Binding="{Binding Customer.Name}" Width="*"/>
                    <DataGridTextColumn Header="الدفع"
                                       Binding="{Binding PaymentMethod}" Width="90"/>
                    <DataGridTextColumn Header="الإجمالي" Width="105">
                        <DataGridTextColumn.Binding>
                            <Binding Path="NetAmount" StringFormat="{}{0:N2} ج"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="المدفوع" Width="105">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PaidAmount" StringFormat="{}{0:N2} ج"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <!-- المتبقي — أخضر لو مسدد، برتقالي لو آجل -->
                    <DataGridTemplateColumn Header="المتبقي" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Setter Property="Text"       Value="مسدد ✓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                    <Setter Property="Text"
                                                            Value="{Binding RemainingAmount,
                                                                   StringFormat='{}{0:N2} ج'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- أزرار الإجراءات -->
                    <DataGridTemplateColumn Header="إجراءات" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- طباعة -->
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            ToolTip="طباعة الفاتورة"
                                            Click="PrintInvoice_Click" Tag="{Binding}">
                                        <materialDesign:PackIcon Kind="Printer"
                                                                 Width="16" Height="16"/>
                                    </Button>
                                    <!-- سداد آجل -->
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            ToolTip="سداد الآجل"
                                            Click="PayCredit_Click" Tag="{Binding}">
                                        <materialDesign:PackIcon Kind="CashPlus"
                                                                 Width="16" Height="16"
                                                                 Foreground="#2E7D32"/>
                                    </Button>
                                    <!-- تعديل -->
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            ToolTip="تعديل الفاتورة"
                                            Click="EditSale_Click" Tag="{Binding}">
                                        <materialDesign:PackIcon Kind="Pencil"
                                                                 Width="16" Height="16"
                                                                 Foreground="#1565C0"/>
                                    </Button>
                                    <!-- حذف -->
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            ToolTip="حذف الفاتورة"
                                            Click="DeleteSale_Click" Tag="{Binding}">
                                        <materialDesign:PackIcon Kind="Delete"
                                                                 Width="16" Height="16"
                                                                 Foreground="#C62828"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- شريط الإجماليات -->
        <materialDesign:Card Grid.Row="2" Padding="12,8" Margin="0,8,0,0" UniformCornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="الإجمالي: " Foreground="#757575" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotal" Text="0.00 جنيه"
                           FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                           FontSize="16" Margin="4,0,24,0" VerticalAlignment="Center"/>
                <TextBlock Text="عدد الفواتير: " Foreground="#757575" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCount" Text="0"
                           FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Page>
