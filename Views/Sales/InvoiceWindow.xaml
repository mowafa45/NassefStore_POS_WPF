<Window x:Class="NassefStore.Views.Sales.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="معاينة الفاتورة" Height="700" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="White" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InvoiceContent" Margin="32" Background="White">
                <!-- رأس الفاتورة -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Padding="0,0,0,16" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="محل ناصف" FontSize="28" FontWeight="Black" Foreground="#1A237E"/>
                            <TextBlock Text="أدوات • سباكة • كهرباء" Foreground="#757575"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="فاتورة ضريبية" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="InvoiceNo" FontSize="13" Foreground="#1A237E" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                            <TextBlock x:Name="InvoiceDate" FontSize="12" Foreground="#757575" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- معلومات العميل -->
                <Border Background="#F5F5F5" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="العميل" FontSize="10" Foreground="#9E9E9E" FontWeight="Bold"/>
                            <TextBlock x:Name="CustomerName" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CustomerPhone" Foreground="#757575" FontSize="12"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="طريقة الدفع" FontSize="10" Foreground="#9E9E9E" FontWeight="Bold"/>
                            <TextBlock x:Name="PaymentMethodText" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- بنود الفاتورة -->
                <DataGrid x:Name="InvoiceItemsGrid"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          BorderThickness="1" BorderBrush="#E0E0E0" Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding Product.Name}" Width="*"/>
                        <DataGridTextColumn Header="كمية" Binding="{Binding Quantity}" Width="55"/>
                        <DataGridTextColumn Header="سعر الوحدة" Width="100">
                            <DataGridTextColumn.Binding><Binding Path="UnitPrice" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الإجمالي" Width="110">
                            <DataGridTextColumn.Binding><Binding Path="TotalPrice" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- الإجماليات -->
                <Border HorizontalAlignment="Left" Width="240">
                    <StackPanel>
                        <Grid Margin="0,4"><TextBlock Text="الإجمالي:" Foreground="#757575" HorizontalAlignment="Right"/><TextBlock x:Name="TotalText" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid>
                        <Grid Margin="0,4"><TextBlock Text="الخصم:" Foreground="#757575" HorizontalAlignment="Right"/><TextBlock x:Name="DiscountText" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid>
                        <Separator Margin="0,4"/>
                        <Grid Margin="0,4">
                            <TextBlock Text="الصافي:" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="NetText" HorizontalAlignment="Left" FontWeight="Bold" FontSize="15" Foreground="#1A237E" FlowDirection="LeftToRight"/>
                        </Grid>
                        <Grid Margin="0,4"><TextBlock Text="المدفوع:" Foreground="#2E7D32" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="PaidText" HorizontalAlignment="Left" Foreground="#2E7D32" FontWeight="SemiBold" FlowDirection="LeftToRight"/></Grid>
                        <Grid Margin="0,4" x:Name="RemainingRow">
                            <TextBlock Text="متبقي (آجل):" Foreground="#E65100" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="RemainingText" HorizontalAlignment="Left" Foreground="#E65100" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- تذييل -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                    <TextBlock Text="شكراً لتعاملكم معنا — محل ناصف"
                               Foreground="#9E9E9E" HorizontalAlignment="Center" FontStyle="Italic"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#F5F5F5" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إغلاق" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="Close_Click" Margin="0,0,8,0"/>
                <Button Content="🖨 طباعة" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Print_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
