<Page x:Class="NassefStore.Views.Sales.NewSalePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5"
      FlowDirection="RightToLeft">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- يمين: لوحة الدفع قابلة للتمرير -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- العميل -->
                <materialDesign:Card Padding="14" Margin="0,0,0,10" UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="العميل" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="CustomerCombo"
                                  materialDesign:HintAssist.Hint="زبون عادي / اختر عميل"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ملخص الدفع -->
                <materialDesign:Card Padding="14" UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="ملخص الفاتورة" Style="{StaticResource SectionTitle}"/>

                        <!-- الإجمالي -->
                        <Grid Margin="0,8">
                            <TextBlock Text="الإجمالي" Foreground="#757575" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtSubtotal" Text="0.00 جنيه"
                                       HorizontalAlignment="Left" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- الخصم -->
                        <Grid Margin="0,4">
                            <TextBlock Text="خصم (جنيه)" Foreground="#757575"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBox x:Name="TxtDiscount" Width="110"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="0"
                                     TextChanged="Discount_Changed" Height="34"/>
                        </Grid>

                        <Separator Margin="0,10"/>

                        <!-- الصافي -->
                        <Grid Margin="0,6">
                            <TextBlock Text="الصافي" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtNetTotal" Text="0.00 جنيه"
                                       HorizontalAlignment="Left" FontWeight="Bold"
                                       FontSize="17" Foreground="#00695C" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,10"/>

                        <!-- طريقة الدفع -->
                        <TextBlock Text="طريقة الدفع" FontSize="12" Foreground="#555"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PaymentMethodCombo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  SelectionChanged="PaymentMethod_Changed">
                            <ComboBoxItem Content="كاش" IsSelected="True"/>
                            <ComboBoxItem Content="فودافون كاش"/>
                            <ComboBoxItem Content="انستا باي"/>
                            <ComboBoxItem Content="آجل"/>
                        </ComboBox>

                        <!-- المبلغ المدفوع -->
                        <TextBlock Text="المبلغ المدفوع (جنيه)" FontSize="12" Foreground="#555"
                                   FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <TextBox x:Name="TxtPaid"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="0.00"
                                 TextChanged="Paid_Changed"/>

                        <!-- المتبقي -->
                        <Grid Margin="0,10,0,6">
                            <TextBlock Text="المتبقي" Foreground="#E65100"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtRemaining" Text="0.00 جنيه"
                                       HorizontalAlignment="Left" FontWeight="Bold"
                                       FontSize="14" Foreground="#E65100" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- تاريخ استحقاق الآجل -->
                        <StackPanel x:Name="DueDatePanel" Visibility="Collapsed" Margin="0,4,0,8">
                            <TextBlock Text="تاريخ الاستحقاق" FontSize="12" Foreground="#555"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DueDatePicker"
                                        Style="{StaticResource MaterialDesignDatePicker}"/>
                        </StackPanel>

                        <!-- ملاحظات -->
                        <TextBlock Text="ملاحظات" FontSize="12" Foreground="#555"
                                   FontWeight="SemiBold" Margin="0,6,0,6"/>
                        <TextBox x:Name="TxtNotes"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="ملاحظة اختيارية..."
                                 Height="55" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"/>

                        <!-- زر إتمام البيع -->
                        <Button Content="✓  إتمام البيع"
                                Margin="0,16,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#00695C" Foreground="White"
                                Height="44" FontSize="15" FontWeight="Bold"
                                Click="CompleteSale_Click"/>

                        <Button Content="مسح" Margin="0,8,0,4"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="34" Click="Clear_Click"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- يسار: البحث والسلة -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط البحث -->
            <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,12" UniformCornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="إضافة" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="AddProduct_Click" Height="40" Width="80"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox"
                             materialDesign:HintAssist.Hint="ابحث عن منتج بالاسم..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"
                             FontSize="14"/>
                </Grid>
            </materialDesign:Card>

            <!-- نتائج البحث -->
            <Popup x:Name="SearchPopup"
                   PlacementTarget="{Binding ElementName=SearchBox}"
                   Placement="Bottom" StaysOpen="False" Width="500">
                <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="SearchResults" MaxHeight="260"
                             MouseDoubleClick="SearchResult_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Category.Name}" Foreground="#9E9E9E" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" Foreground="#E65100">
                                        <Run Text="مخزون: "/>
                                        <Run Text="{Binding StockQuantity}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               FontWeight="Bold" Foreground="#00695C" FontSize="13">
                                        <Run Text="{Binding SellPrice, StringFormat=N2}"/>
                                        <Run Text=" ج"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <!-- السلة -->
            <materialDesign:Card Grid.Row="1" Padding="12" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="بنود الفاتورة"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="CartGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              CellEditEnding="CartGrid_CellEditEnding"
                              PreviewKeyDown="CartGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}"
                                               Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="السعر" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UnitPrice" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="خصم" Binding="{Binding Discount}" Width="60"/>
                            <DataGridTextColumn Header="الإجمالي" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="LineTotal" StringFormat="{}{0:N2} ج"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="28" Height="28"
                                                Click="RemoveItem_Click" Tag="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="15" Height="15"
                                                                     Foreground="#C62828"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>
