<Page x:Class="NassefStore.Views.Suppliers.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5" FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <!-- تفاصيل المورد -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12" UniformCornerRadius="8"
                                 x:Name="SupplierInfoCard" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FFEBEE" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="المتبقي" FontSize="10" Foreground="#757575"/>
                            <TextBlock x:Name="TxtBalanceDue" FontSize="16" FontWeight="Bold" Foreground="#C62828" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="المدفوع" FontSize="10" Foreground="#757575"/>
                            <TextBlock x:Name="TxtTotalPaid" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي الشراء" FontSize="10" Foreground="#757575"/>
                            <TextBlock x:Name="TxtTotalPurchased" FontSize="16" FontWeight="Bold" Foreground="#1565C0" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                        <TextBlock x:Name="SupplierName" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock x:Name="SupplierPhone" Foreground="#757575"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
            <materialDesign:Card Grid.Row="1" Padding="12" Margin="0,0,0,12" UniformCornerRadius="8"
                                 x:Name="ActionsCard" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Content="💰 إضافة دفعة" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource SuccessBrush}" Click="AddPayment_Click" Margin="0,0,8,0"/>
                    <Button Content="+ فاتورة شراء جديدة" Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="NewPurchase_Click" Margin="0,0,8,0"/>
                    <Button Content="تصفية" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="Filter_Click" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DateTo" Style="{StaticResource MaterialDesignDatePicker}"
                                materialDesign:HintAssist.Hint="إلى" Width="140" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DateFrom" Style="{StaticResource MaterialDesignDatePicker}"
                                materialDesign:HintAssist.Hint="من" Width="140"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Row="2" Padding="16" UniformCornerRadius="8"
                                 x:Name="PurchasesCard" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="سجل المشتريات" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="PurchasesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفاتورة" Binding="{Binding InvoiceNumber}" Width="140"/>
                            <DataGridTextColumn Header="التاريخ" Width="100">
                                <DataGridTextColumn.Binding><Binding Path="PurchaseDate" StringFormat="dd/MM/yyyy"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الإجمالي" Width="120">
                                <DataGridTextColumn.Binding><Binding Path="TotalAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المدفوع" Width="110">
                                <DataGridTextColumn.Binding><Binding Path="PaidAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المتبقي" Width="110">
                                <DataGridTextColumn.Binding><Binding Path="RemainingAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethod}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Row="0" Grid.RowSpan="3" Padding="40" UniformCornerRadius="8"
                                 x:Name="PlaceholderCard">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="64" Height="64" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                    <TextBlock Text="اختر مورداً لعرض حساباته" Foreground="#9E9E9E" FontSize="16" Margin="0,16,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
        <!-- قائمة الموردين -->
        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="الموردون" Style="{StaticResource SectionTitle}"/>
                <TextBox Grid.Row="1" x:Name="SearchBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="🔍 بحث..."
                         TextChanged="Search_Changed" Margin="0,0,0,8"/>
                <ListBox Grid.Row="2" x:Name="SuppliersList" SelectionChanged="SuppliersList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Phone}" Foreground="#9E9E9E" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="3" Content="+ إضافة مورد" Margin="0,8,0,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="AddSupplier_Click"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
