<Page x:Class="NassefStore.Views.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      Background="#F5F5F5"
      FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="تحديث" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="Refresh_Click" Margin="8,0,0,0"/>
                    <DatePicker x:Name="DashDate"
                                Style="{StaticResource MaterialDesignDatePicker}"
                                Width="160"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="نظرة اليوم" Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- بطاقات الملخص -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border Background="#E8F5E9" CornerRadius="8" Padding="8" Width="40" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="#2E7D32"/>
                        </Border>
                        <TextBlock Text="إجمالي المبيعات" Foreground="#757575" FontSize="12"/>
                        <TextBlock x:Name="TxtTotalSales" Text="0.00 جنيه" FontSize="20" FontWeight="Bold" Foreground="#212121" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="TxtInvoiceCount" Text="0 فاتورة" FontSize="12" Foreground="#9E9E9E"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="8" Width="40" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Cash" Width="24" Height="24" Foreground="#1565C0"/>
                        </Border>
                        <TextBlock Text="المبالغ المحصلة" Foreground="#757575" FontSize="12"/>
                        <TextBlock x:Name="TxtCash" Text="0.00 جنيه" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVodafone" Text="فودافون: 0" FontSize="11" Foreground="#9E9E9E"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="#9E9E9E"/>
                            <TextBlock x:Name="TxtInstaPay" Text="انستا: 0" FontSize="11" Foreground="#9E9E9E"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border Background="#FFF3E0" CornerRadius="8" Padding="8" Width="40" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="24" Height="24" Foreground="#E65100"/>
                        </Border>
                        <TextBlock Text="آجل غير مسدد" Foreground="#757575" FontSize="12"/>
                        <TextBlock x:Name="TxtCredit" Text="0.00 جنيه" FontSize="20" FontWeight="Bold" Foreground="#E65100" FlowDirection="LeftToRight"/>
                        <TextBlock Text="رصيد غير مدفوع" FontSize="12" Foreground="#9E9E9E"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border Background="#FFEBEE" CornerRadius="8" Padding="8" Width="40" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="24" Height="24" Foreground="#C62828"/>
                        </Border>
                        <TextBlock Text="نواقص المخزون" Foreground="#757575" FontSize="12"/>
                        <TextBlock x:Name="TxtLowStock" Text="0" FontSize="20" FontWeight="Bold" Foreground="#C62828"/>
                        <TextBlock Text="تحتاج تعبئة" FontSize="12" Foreground="#9E9E9E"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- جدول المبيعات + النواقص -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="مبيعات اليوم" Style="{StaticResource SectionTitle}"/>
                        <DataGrid x:Name="RecentSalesGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  MaxHeight="320" Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="130"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding Customer.Name}" Width="*"/>
                                <DataGridTextColumn Header="الوقت" Width="70">
                                    <DataGridTextColumn.Binding><Binding Path="SaleDate" StringFormat="HH:mm"/></DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethod}" Width="90"/>
                                <DataGridTextColumn Header="الإجمالي" Width="110">
                                    <DataGridTextColumn.Binding><Binding Path="NetAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="⚠ تنبيه نواقص المخزون" Style="{StaticResource SectionTitle}" Foreground="#C62828"/>
                        <ItemsControl x:Name="LowStockList" MaxHeight="320">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFCDD2" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#FFEBEE"
                                                    CornerRadius="12" Padding="8,2" Margin="0,0,8,0">
                                                <TextBlock Foreground="#C62828" FontWeight="Bold" FontSize="12">
                                                    <Run Text="{Binding StockQuantity}"/>
                                                    <Run Text=" متبقي"/>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Category.Name}" Foreground="#9E9E9E" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoLowStockText" Text="✓ المخزون في حالة جيدة"
                                   Foreground="#2E7D32" HorizontalAlignment="Center"
                                   Margin="0,16" Visibility="Collapsed"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
