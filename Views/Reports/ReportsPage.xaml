<Page x:Class="NassefStore.Views.Reports.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5" FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="هذا الشهر" Style="{StaticResource MaterialDesignOutlinedButton}" Click="ThisMonth_Click" Margin="0,0,8,0"/>
                <Button Content="اليوم" Style="{StaticResource MaterialDesignOutlinedButton}" Click="Today_Click" Margin="0,0,8,0"/>
                <Button Content="إنشاء التقرير" Style="{StaticResource MaterialDesignRaisedButton}" Click="Generate_Click" Margin="0,0,8,0"/>
                <DatePicker x:Name="DateTo" Style="{StaticResource MaterialDesignDatePicker}" Width="150" Margin="0,0,8,0"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="DateFrom" Style="{StaticResource MaterialDesignDatePicker}" Width="150" Margin="0,0,8,0"/>
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </StackPanel>
        </materialDesign:Card>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialDesign:Card Grid.Column="0" Padding="12" Margin="0,0,6,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="إجمالي الإيرادات" FontSize="11" Foreground="#757575"/>
                    <TextBlock x:Name="TxtRevenue" Text="—" FontSize="17" FontWeight="Bold" Foreground="#1A237E" FlowDirection="LeftToRight"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Column="1" Padding="12" Margin="3,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="كاش" FontSize="11" Foreground="#757575"/>
                    <TextBlock x:Name="TxtCash" Text="—" FontSize="17" FontWeight="Bold" Foreground="#2E7D32" FlowDirection="LeftToRight"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Column="2" Padding="12" Margin="3,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="فودافون كاش" FontSize="11" Foreground="#757575"/>
                    <TextBlock x:Name="TxtVodafone" Text="—" FontSize="17" FontWeight="Bold" Foreground="#E65100" FlowDirection="LeftToRight"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Column="3" Padding="12" Margin="3,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="انستا باي" FontSize="11" Foreground="#757575"/>
                    <TextBlock x:Name="TxtInstaPay" Text="—" FontSize="17" FontWeight="Bold" Foreground="#6A1B9A" FlowDirection="LeftToRight"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Column="4" Padding="12" Margin="6,0,0,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="آجل غير مسدد" FontSize="11" Foreground="#757575"/>
                    <TextBlock x:Name="TxtCredit" Text="—" FontSize="17" FontWeight="Bold" Foreground="#C62828" FlowDirection="LeftToRight"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
        <materialDesign:Card Grid.Row="2" Padding="16" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="فواتير المبيعات" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="TxtInvoiceCount" HorizontalAlignment="Left" Foreground="#757575" FontSize="13"/>
                    </Grid>
                    <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفاتورة" Binding="{Binding InvoiceNumber}" Width="130"/>
                            <DataGridTextColumn Header="التاريخ" Width="90">
                                <DataGridTextColumn.Binding><Binding Path="SaleDate" StringFormat="dd/MM/yyyy"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer.Name}" Width="*"/>
                            <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethod}" Width="90"/>
                            <DataGridTextColumn Header="الإجمالي" Width="110">
                                <DataGridTextColumn.Binding><Binding Path="NetAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المتبقي" Width="100">
                                <DataGridTextColumn.Binding><Binding Path="RemainingAmount" StringFormat="{}{0:N2} ج"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="أكثر المنتجات مبيعاً" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="TopProductsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="#757575" FontSize="11">
                                                <Run Text="كمية: "/><Run Text="{Binding Quantity}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock Text=" | " Foreground="#BDBDBD" FontSize="11"/>
                                            <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="11" FlowDirection="LeftToRight">
                                                <Run Text="{Binding Revenue, StringFormat=N2}" FontWeight="Bold"/>
                                                <Run Text=" ج"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
